# =============================================================================
# NKP Deployment Environment Template
# Copy this file to environment.env and fill in all required values.
# Variable names here MUST match exactly what the scripts read.
# =============================================================================

# =============================================================================
# CLUSTER CONFIGURATION
# =============================================================================
CLUSTER_NAME=

# =============================================================================
# NODE ADDRESSES
# Fill in the IP or hostname for each control-plane and worker node.
# =============================================================================
CONTROL_PLANE_1_ADDRESS=
CONTROL_PLANE_2_ADDRESS=
CONTROL_PLANE_3_ADDRESS=

WORKER_1_ADDRESS=
WORKER_2_ADDRESS=
WORKER_3_ADDRESS=
WORKER_4_ADDRESS=

# Derived lists — computed automatically; do not edit unless adding more nodes.
CONTROL_PLANE_NODES="${CONTROL_PLANE_1_ADDRESS} ${CONTROL_PLANE_2_ADDRESS} ${CONTROL_PLANE_3_ADDRESS}"
WORKER_NODES="${WORKER_1_ADDRESS} ${WORKER_2_ADDRESS} ${WORKER_3_ADDRESS} ${WORKER_4_ADDRESS}"
ALL_NODES="${CONTROL_PLANE_NODES} ${WORKER_NODES}"

# =============================================================================
# CONTROL PLANE ENDPOINT
# =============================================================================
CONTROL_PLANE_ENDPOINT_HOST=
CONTROL_PLANE_ENDPOINT_PORT=6443
VIRTUAL_IP_INTERFACE=

# =============================================================================
# SSH CONFIGURATION
# =============================================================================
SSH_USER=
SSH_PRIVATE_KEY_FILE=~/.ssh/id_rsa
SSH_PRIVATE_KEY_SECRET_NAME=

# =============================================================================
# NETWORKING
# =============================================================================
METALLB_IP_RANGE=
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12

# =============================================================================
# PROXY (optional — leave blank if not needed)
# =============================================================================
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# =============================================================================
# PRISM CENTRAL (used by the UI for auto-discovery; PRISM_CENTRAL_PASSWORD is
# NOT stored here — it is prompted at runtime and kept in memory only)
# =============================================================================
PRISM_CENTRAL_IP=
PRISM_CENTRAL_USERNAME=
PRISM_CENTRAL_VERIFY_SSL=false

# Deployment targets (populated via the UI after Prism Central verification)
TARGET_CLUSTER=
TARGET_SUBNET=
TARGET_PROJECT=
STORAGE_CONTAINER=

# =============================================================================
# STORAGE
# =============================================================================
STORAGE_PROVIDER=local-volume-provisioner

# Nutanix CSI — fill in only when STORAGE_PROVIDER=nutanix-csi
NUTANIX_ENDPOINT=
NUTANIX_USER=
NUTANIX_PASSWORD=
NUTANIX_CLUSTER_UUID=

# =============================================================================
# LICENSE (optional — can be applied via the UI after deployment)
# =============================================================================
LICENSE_TYPE=pro
NKP_LICENSE_TOKEN=

# =============================================================================
# REGISTRY (optional — for authenticated or mirror registries)
# =============================================================================
REGISTRY_MIRROR_URL=
REGISTRY_MIRROR_USERNAME=
REGISTRY_MIRROR_PASSWORD=

# =============================================================================
# AIR-GAPPED (optional — set AIRGAPPED=true and fill in bundle paths)
# =============================================================================
AIRGAPPED=false
LOCAL_REGISTRY_URL=
LOCAL_REGISTRY_CA_CERT=
LOCAL_REGISTRY_USERNAME=
LOCAL_REGISTRY_PASSWORD=
NKP_BUNDLE_PATH=
KONVOY_IMAGE_BUNDLE=
KOMMANDER_IMAGE_BUNDLE=
KOMMANDER_CHARTS_BUNDLE=

# =============================================================================
# OUTPUT PATHS
# =============================================================================
OUTPUT_DIR=${PWD}/nkp-output
KUBECONFIG_PATH=${OUTPUT_DIR}/nkp-mgmt.conf

# =============================================================================
# TIMEOUTS AND FLAGS
# =============================================================================
CLUSTER_CREATE_TIMEOUT=60m
KOMMANDER_INSTALL_TIMEOUT=45m
NODE_READY_TIMEOUT=30m
DRY_RUN=false
VERBOSE=false
FIPS_MODE=false
